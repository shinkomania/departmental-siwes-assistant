# Departmental SIWES Assistant (DSA) Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# SQLite Database Location
DATABASE_URL=sqlite:///instance/database.db

# Live Web Search API Configuration (Optional)
# Leave empty to use verified internal database only.
# Supported provider adapters: serpapi, tavily, google_search
SEARCH_API_KEY=
SEARCH_PROVIDER=none

# Admin Access Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
